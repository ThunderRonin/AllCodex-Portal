# ── AllCodex Portal Environment Variables ──────────────────────────────────

# Auto-provisioning — these are required for zero-login operation.
# In development, matching defaults are used automatically.
ALLKNOWER_URL=http://localhost:3001
PORTAL_INTERNAL_SECRET=dev-portal-secret-32chars!!!

# Legacy manual overrides — only needed if auto-provisioning is disabled.
# ALLCODEX_URL=http://localhost:8080
# ALLCODEX_ETAPI_TOKEN=
# ALLKNOWER_BEARER_TOKEN=

# Lore root note (optional)
# The AllCodex note ID that serves as the parent for all lore entries.
# Defaults to "root" (the AllCodex root note) if not set.
# LORE_ROOT_NOTE_ID=root

# VAPID public key for web push notifications
VAPID_PUBLIC_KEY=BA7l1SU3zndRPDRCP5PDjTxCJ8Lk-rDaGSPdj7hwXuzaMDcKbE406EOdeiV37Wz6bC2nEQ14pOKwgC3cKtg7IZA

# Public portal URL for sharing resolution (omit trailing slash)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
